# Copy to infra/env/backend.env. Values stay on the server and are never committed.
NODE_ENV=production
PORT=4000
DATABASE_URL=
DIRECT_URL=
DATABASE_SSL=require
DATABASE_SSL_CA_PATH=
DATABASE_POOL_IDLE_TIMEOUT_MS=120000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
FRONTEND_URL=https://staging.example.com
PUBLIC_MEDIA_BASE_URL=https://staging.example.com/uploads
SESSION_SECRET=
RATE_LIMIT_PER_MINUTE=300
CONTACT_RATE_LIMIT_PER_HOUR=5
CONTACT_RETENTION_MONTHS=12
CONTACT_RETENTION_INTERVAL_HOURS=24
# Must stay false on the live site, so unapproved pages stay hidden (decision 0012).
# Staging sets true so the firm's advocate can review them.
PREVIEW_UNREVIEWED_PAGES=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WP_BASE_URL=https://warenlaw.com
WP_REQUEST_INTERVAL_MS=1100
WP_CACHE_DIR=.cache
WP_USER_AGENT=waren-rebuild-import/1.0
URL_INVENTORY_PATH=../../docs/seo/url-inventory.csv
