# Copy to infra/env/deploy.env. Used by Docker Compose and fixed into the frontend build.
SITE_URL=https://staging.example.com
SERVER_NAME=staging.example.com
# false adds noindex everywhere. Keep false for V1 and staging.
SITE_INDEXABLE=false
REVALIDATE_SECONDS=300
REDIRECT_CACHE_SECONDS=300
# off, or a realm name such as "WAREN staging" to require a password. Staging uses a realm.
BASIC_AUTH=off
# Path on the server to an htpasswd file, needed when BASIC_AUTH isn't off.
BASIC_AUTH_FILE=./nginx/htpasswd.example
# The certbot folder on the server, and the folder certbot uses to renew.
TLS_DIR=/etc/letsencrypt
ACME_DIR=/var/www/acme
