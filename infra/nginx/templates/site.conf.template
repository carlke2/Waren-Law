upstream frontend {
    server frontend:3000;
    keepalive 16;
}

upstream backend {
    server backend:4000;
    keepalive 16;
}

proxy_cache_path /var/cache/nginx/waren levels=1:2 keys_zone=waren:20m max_size=1g inactive=30d use_temp_path=off;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/css text/plain text/xml application/javascript application/json application/rss+xml application/xml image/svg+xml;

server {
    listen 80 default_server;
    server_name ${SERVER_NAME} www.${SERVER_NAME};

    location = /nginx-health {
        access_log off;
        return 200;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name www.${SERVER_NAME};
    ssl_certificate /etc/nginx/tls/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/live/${SERVER_NAME}/privkey.pem;
    return 301 https://${SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/tls/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    auth_basic "${BASIC_AUTH}";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    include /etc/nginx/snippets/security-headers.conf;

    location ~* ^/(wp-admin|wp-login\.php|xmlrpc\.php) {
        auth_basic off;
        return 410;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://backend;
    }

    # The frontend's image optimiser fetches these through this server, without a staging password.
    location /uploads/ {
        auth_basic off;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://backend;
        proxy_cache waren;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /_next/static/ {
        auth_basic off;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://frontend;
        proxy_cache waren;
        proxy_cache_valid 200 365d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /_next/image {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://frontend;
        proxy_cache waren;
        proxy_cache_valid 200 7d;
        proxy_cache_key $scheme$host$request_uri$http_accept;
        proxy_cache_use_stale error timeout updating;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://frontend;
    }
}
