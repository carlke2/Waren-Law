{
  "name": "waren-law",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run --if-present dev",
    "build": "bash infra/scripts/build-production.sh",
    "start": "bash infra/scripts/start-production.sh",
    "prod": "pnpm build && pnpm start",
    "lint": "node scripts/check-theme.ts && eslint .",
    "typecheck": "pnpm -r run --if-present typecheck",
    "test": "pnpm -r run --if-present test",
    "test:e2e": "pnpm --filter @waren/frontend test:e2e",
    "import:wp": "pnpm --filter @waren/import-wordpress start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
