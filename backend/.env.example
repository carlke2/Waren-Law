NODE_ENV=development
PORT=4000
# Supabase pooler, transaction mode, with the pgbouncer flag Supabase documents for Prisma.
DATABASE_URL=
# Supabase direct connection, used by migrations. Add ?sslmode=require. The direct host is IPv6-only;
# without IPv6 use the session pooler (the pooler host on port 5432).
DIRECT_URL=
# disable, require (encrypted) or verify (encrypted and checked against DATABASE_SSL_CA_PATH).
DATABASE_SSL=require
DATABASE_SSL_CA_PATH=
DATABASE_POOL_IDLE_TIMEOUT_MS=120000
# Connections kept open: opening one over TLS takes about 1 s when the database is far away.
DATABASE_POOL_MIN=4
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
# Local or Docker PostgreSQL only; the database must be named waren_test.
TEST_DATABASE_URL=
FRONTEND_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=
RATE_LIMIT_PER_MINUTE=300
CONTACT_RATE_LIMIT_PER_HOUR=5
NEWSLETTER_RATE_LIMIT_PER_HOUR=5
CONTACT_RETENTION_MONTHS=12
CONTACT_RETENTION_INTERVAL_HOURS=24
# true shows pages awaiting advocate review. Never set this in production.
PREVIEW_UNREVIEWED_PAGES=false
UPLOADS_DIR=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
